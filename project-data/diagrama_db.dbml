// Ecosistema FESW 2026 - Modelo de Base de Datos

Table usuario {
  id uuid [pk]
  email string [unique]
  hashed_password string
  nombre_completo string
  telefono string
  activo boolean
  email_verificado boolean
  fecha_creacion timestamp
  fecha_actualizacion timestamp
}

Table proveedor {
  id uuid [pk]
  rut string [unique]
  razon_social string
  nombre_fantasia string
  descripcion_libre text
  regiones string
  rubros string
  certificaciones string
  palabras_clave string
  anios_experiencia int
  num_empleados int
  fecha_cambio_perfil timestamp
  fecha_creacion timestamp
  fecha_actualizacion timestamp
}

Table proveedor_usuario {
  id uuid [pk]
  usuario_id uuid
  proveedor_id uuid
  rol string
  fecha_ingreso timestamp
}

Table licitacion {
  id uuid [pk]
  codigo_externo string [unique]
  nombre string
  descripcion text
  estado string
  codigo_estado int
  tipo int
  monto_estimado float
  organismo_nombre string
  region string
  comuna string
  fecha_cierre timestamp
  resumen_ia text
  requisitos_extraidos json
  qdrant_vector_id string
  fecha_ingesta timestamp
  fecha_actualizacion timestamp
}

Table documento_licitacion {
  id uuid [pk]
  licitacion_id uuid
  nombre string
  tipo string
  url text
  procesado boolean
  fecha_procesamiento timestamp
}

Table resultado_matching {
  id uuid [pk]
  proveedor_id uuid
  licitacion_id uuid
  score_similitud float
  score_reranker float
  score_final float
  razones_match json
  version_modelo string
  fecha_calculo timestamp
}

Table pregunta_perfil {
  id uuid [pk]
  proveedor_id uuid
  licitacion_id uuid
  tipo_discrepancia string
  requisito_licitacion text
  pregunta text
  campo_perfil_destino string
  respondida boolean
  respuesta text
  omitida boolean
  fecha_generacion timestamp
  fecha_respuesta timestamp
}

// ---- RELACIONES (Cardinalidad 1:N) ----

Ref: proveedor_usuario.usuario_id > usuario.id [delete: cascade, update: cascade]
Ref: proveedor_usuario.proveedor_id > proveedor.id [delete: cascade, update: cascade]

Ref: resultado_matching.proveedor_id > proveedor.id [delete: cascade]
Ref: resultado_matching.licitacion_id > licitacion.id [delete: cascade]

Ref: pregunta_perfil.proveedor_id > proveedor.id [delete: cascade]
Ref: pregunta_perfil.licitacion_id > licitacion.id [delete: cascade]

Ref: documento_licitacion.licitacion_id > licitacion.id [delete: cascade]