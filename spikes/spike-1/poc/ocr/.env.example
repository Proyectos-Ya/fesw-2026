# Copiar a `.env` (sin el `.example`) y completar con las credenciales reales.
# `.env` está en .gitignore — nunca se commitea. Este archivo, sin valores, sí.
#
# Ninguna variable es obligatoria: un extractor sin sus credenciales completas
# se reporta como "no disponible" en `benchmark.py --listar`, con el mensaje
# exacto de qué falta. No se hace ninguna llamada de red sin esto.

# --- Gemini ---
# Mismas variables que ya usa el backend (ver app/config.py: gemini_api_key,
# gemini_model). Si el backend ya las tiene configuradas, se pueden copiar
# tal cual acá.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Google Document AI ---
# El token de acceso NO es una API key permanente: se genera con
# `gcloud auth print-access-token` y expira en ~1 hora. Para una corrida larga
# hay que regenerarlo y volver a pegarlo acá. Requiere haber creado antes un
# procesador de tipo OCR en Google Cloud Console → Document AI.
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_ACCESS_TOKEN=

# --- Unstructured ---
# Workflow API (jobs asíncronos, ver ocr_bench/extractors.py): usar la URL
# exacta que muestra el dashboard al crear la key, normalmente algo como
# https://platform-api.transform.unstructured.io/api/v1 — la API clásica de
# un solo POST (api.unstructuredapp.io/general/v0/general) devuelve 404 en
# cuentas aprovisionadas para Workflow API.
UNSTRUCTURED_API_URL=
UNSTRUCTURED_API_KEY=

# --- LlamaParse (LlamaCloud) ---
# Sin URL propia: el endpoint es fijo (api.cloud.llamaindex.ai), ver
# ocr_bench/extractors.py.
LLAMA_CLOUD_API_KEY=
