# Copiar a `.env` (sin el `.example`) y completar con las credenciales reales.
# `.env` está en .gitignore — nunca se commitea. Este archivo, sin valores, sí.
#
# Ninguna variable es obligatoria: una fuente sin sus dos variables
# configuradas se reporta como "no disponible" con un mensaje claro, tanto en
# perfilar_rut.py como en el notebook. Se pueden completar solo las que se
# vayan a usar.

# --- Web Empresario ---
# {rut} es el marcador que perfilar_rut.py reemplaza por el RUT normalizado.
WEB_EMPRESARIO_URL=https://api-sii-chile.webempresario.com/v1/{rut}
WEB_EMPRESARIO_TOKEN=

# --- ruts.info ---
RUTS_INFO_URL=https://.../consulta?rut={rut}
RUTS_INFO_TOKEN=

# --- SRE ---
# Sin {rut}: SRE es POST y el RUT va en el cuerpo, no en la URL.
SRE_URL=https://sre.cl/api/company_info
SRE_TOKEN=
