# Node.js
# El frontend tiene su propio .gitignore, más cercano y por lo tanto prioritario
# para sus rutas (.next/, out/, build/, coverage). Aquí queda lo que aplica a
# cualquier paquete Node que se agregue al monorepo.
node_modules/
dist/
pnpm-debug.log*

# Python
# Los patrones de directorio van anclados con "/" inicial: sin anclar coinciden a
# cualquier profundidad, y "env/" llegaría a ignorar en silencio un app/env/ con
# código adentro.
/.venv/
/venv/
/env/
/ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.envrc
.direnv

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Playwright
playwright-report/
test-results/

# Claude Code
CLAUDE.md
.claude

PENDIENTES.md