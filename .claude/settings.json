{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Cristobal/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Cristobal/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}