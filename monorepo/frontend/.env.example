# URL del backend. En desarrollo puede omitirse y cae a http://localhost:8000.
#
# En un build de producción es OBLIGATORIA: si falta, el build falla a propósito.
# Antes caía a localhost en silencio, lo que hacía que el frontend desplegado
# llamara al equipo del propio visitante — sin error visible en el despliegue.
NEXT_PUBLIC_API_URL=http://localhost:8000
