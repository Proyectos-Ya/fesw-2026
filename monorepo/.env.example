# ─────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────
# POSTGRES_HOST solo aplica al ejecutar el backend de forma nativa (Flujo B).
# Dentro de docker compose, el servicio `api` lo sobrescribe a `postgres`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proyectosya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


# ─────────────────────────────────────
# Qdrant
# ─────────────────────────────────────
# Igual que arriba: dentro de compose, `api` lo sobrescribe a `qdrant`.
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334


# ─────────────────────────────────────
# Mercado Público
# ─────────────────────────────────────
# Obligatoria: sin ella la aplicación no arranca.
MERCADO_PUBLICO_API_KEY=your_mercado_publico_ticket_here

# En true limita la ingesta a unas pocas licitaciones para no agotar la cuota
# diaria de la API. Debe ser false en producción.
IS_DEV=true


# ─────────────────────────────────────
# Gemini
# ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_here


# ─────────────────────────────────────
# Autenticación
# ─────────────────────────────────────
# Obligatoria. Genera una cadena aleatoria de al menos 32 bytes, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=genera_tu_propia_clave_aleatoria_aqui


# ─────────────────────────────────────
# Opcionales
# ─────────────────────────────────────
# Solo en Windows con el repositorio en el disco C:\ en vez de dentro de WSL2:
# fuerza a uvicorn --reload a sondear los archivos porque los eventos de
# inotify no cruzan esa frontera.
# WATCHFILES_FORCE_POLLING=1


# ─────────────────────────────────────
# Ingesta de Mercado Público
# ─────────────────────────────────────
MERCADOPUBLICO_FETCHING_LIMIT=2000
MERCADOPUBLICO_DETAIL_DELAY=2.0
