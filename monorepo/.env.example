# Configuración del proyecto. Copia este archivo y completa solo lo de arriba:
#
#   cp .env.example .env
#
# Todo lo demás ya viene listo para desarrollo local con `supabase start`.


# ═════════════════════════════════════════════════════════════════
# 1. LO QUE TIENES QUE COMPLETAR  (3 valores)
# ═════════════════════════════════════════════════════════════════

# Firma de las sesiones. Genera la tuya, no la compartas ni copies de otro:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# La aplicación no arranca sin ella y rechaza claves de menos de 32 bytes.
JWT_SECRET_KEY=

# Ticket de la API de Mercado Público. Pídelo al equipo.
# La cuota (10.000 peticiones/día) es del ticket, no de tu máquina: si varios
# usan el mismo a la vez, se agota entre todos.
MERCADO_PUBLICO_API_KEY=

# Clave de Gemini, para el análisis profundo. Pídela al equipo.
GEMINI_API_KEY=


# ═════════════════════════════════════════════════════════════════
# 2. LISTO PARA USAR  (no necesitas tocar nada de acá abajo)
# ═════════════════════════════════════════════════════════════════

GEMINI_MODEL=gemini-3.1-flash-lite

# --- Base de datos: Supabase local (`supabase start`) ---
# Gana sobre los POSTGRES_* de más abajo. Para apuntar a Supabase en la nube,
# cópiala de Project Settings > Database; se puede pegar tal cual venga
# (postgresql:// o postgres://), el código normaliza el driver.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Respaldo por si no defines DATABASE_URL. POSTGRES_PASSWORD tiene que existir
# aunque no se use.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proyectosya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Qdrant ---
# Dentro de docker compose, el servicio `api` sobrescribe el host a `qdrant`.
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Modo desarrollo ---
# Activa el log de SQL y deja la cookie de sesión sin el atributo Secure.
# Debe ser false en producción.
IS_DEV=true

# --- Ingesta de Mercado Público ---
# Licitaciones por ciclo. 100 alcanza para trabajar en local; en producción, 2000.
MERCADOPUBLICO_FETCHING_LIMIT=100
# Pausa entre descargas de detalle, en segundos. Bajarlo gatilla el 429 de la API.
MERCADOPUBLICO_DETAIL_DELAY=0.5
# Ponlo en false para trabajar sin consumir cuota, con el corpus ya cargado.
RUN_AUTO_INGESTION=true

# --- Frontend autorizado (CORS) ---
# Separados por coma. Nunca "*": con cookies el navegador lo rechaza.
CORS_ORIGINS=http://localhost:3000


# --- Solo si estás en Windows con el repositorio en C:\ (no dentro de WSL2) ---
# Fuerza a uvicorn --reload a sondear los archivos: los eventos de inotify no
# cruzan esa frontera y el hot reload deja de funcionar.
# WATCHFILES_FORCE_POLLING=1

# --- Solo si necesitas acotar la ingesta a una región ---
# OJO: para NO filtrar, deja esta línea comentada. `TARGET_REGION=null` no
# funciona: se lee como el texto "null", que es un valor válido, y no entraría
# ninguna licitación.
# TARGET_REGION=Región Metropolitana de Santiago

# El resto de la configuración (variante del reranker y su calibración, pooler de
# Postgres, atributos de la cookie) tiene valores por defecto correctos para
# desarrollo. Están documentados en backend/app/config.py cuando hagan falta.
