# ─────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────
# POSTGRES_HOST solo aplica al ejecutar el backend de forma nativa (Flujo B).
# Dentro de docker compose, el servicio `api` lo sobrescribe a `postgres`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proyectosya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


# ─────────────────────────────────────
# Qdrant
# ─────────────────────────────────────
# Igual que arriba: dentro de compose, `api` lo sobrescribe a `qdrant`.
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334


# ─────────────────────────────────────
# Mercado Público
# ─────────────────────────────────────
# Obligatoria: sin ella la aplicación no arranca.
MERCADO_PUBLICO_API_KEY=your_mercado_publico_ticket_here

# En true limita la ingesta a unas pocas licitaciones para no agotar la cuota
# diaria de la API. Debe ser false en producción.
IS_DEV=true


# ─────────────────────────────────────
# Gemini
# ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_here


# ─────────────────────────────────────
# Autenticación
# ─────────────────────────────────────
# Obligatoria. Genera una cadena aleatoria de al menos 32 bytes, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=genera_tu_propia_clave_aleatoria_aqui


# ─────────────────────────────────────
# Base de datos
# ─────────────────────────────────────
# Cadena de conexión completa. Si está definida, GANA sobre los POSTGRES_* de
# arriba. Es la forma de apuntar a un Postgres gestionado (Supabase).
#
#   Supabase local (`supabase start`), corriendo la API fuera de Docker:
#     DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   Supabase local, con la API dentro de Docker: usa
#     docker-compose.supabase.yml, que ya la define apuntando a
#     host.docker.internal.
#   Supabase en la nube: cópiala de Project Settings > Database.
#
# El esquema puede venir como postgresql:// o postgres://; el código lo
# normaliza a asyncpg, así que puedes pegarla tal cual.
# DATABASE_URL=

# Obligatorio detrás del pooler de Supabase (Supavisor, puerto 6543) o de
# cualquier PgBouncer en modo transacción. Ahí cada consulta puede caer en una
# conexión distinta, y las sentencias preparadas de asyncpg fallan de forma
# intermitente con "prepared statement does not exist".
# Con conexión directa (puerto 5432) déjalo en false.
# DB_DISABLE_PREPARED_STATEMENTS=false


# ─────────────────────────────────────
# Despliegue: CORS y cookie de sesión
# ─────────────────────────────────────
# Orígenes autorizados del frontend, separados por coma. Sin esto, un frontend
# en otro dominio recibe error de CORS. Nunca uses "*": con cookies el navegador
# lo rechaza, y aunque no lo hiciera abriría la API a cualquier sitio.
CORS_ORIGINS=http://localhost:3000

# Atributo Secure de la cookie de sesión. Si no se declara, se deriva de IS_DEV:
# apagado en desarrollo, encendido fuera. Decláralo solo para forzar un caso raro
# (por ejemplo, TLS terminado en un proxy).
# AUTH_COOKIE_SECURE=true

# SameSite de la cookie. "lax" sirve mientras frontend y backend compartan sitio.
# Si quedan en dominios distintos hace falta "none", que exige Secure.
# AUTH_COOKIE_SAMESITE=lax


# ─────────────────────────────────────
# Opcionales
# ─────────────────────────────────────
# Solo en Windows con el repositorio en el disco C:\ en vez de dentro de WSL2:
# fuerza a uvicorn --reload a sondear los archivos porque los eventos de
# inotify no cruzan esa frontera.
# WATCHFILES_FORCE_POLLING=1


# ─────────────────────────────────────
# Ingesta de Mercado Público
# ─────────────────────────────────────
# Máximo de licitaciones que se piden por ciclo de ingesta. En local conviene
# bajarlo (200 alcanza para trabajar) para no esperar la carga completa.
MERCADOPUBLICO_FETCHING_LIMIT=2000
# Pausa entre descargas de detalle, en segundos. Bajarlo gatilla el 429 de la API.
MERCADOPUBLICO_DETAIL_DELAY=2.0


# ─────────────────────────────────────
# Reranker (matching)
# ─────────────────────────────────────
# Variante ONNX del modelo bge-reranker-v2-m3. Es el mismo modelo en distinta
# precisión numérica; el repositorio publica ocho y bajarlas todas son 8,3 GB.
#
#   model_quantized.onnx   INT8, 571 MB   <- por defecto
#   model_fp16.onnx        fp16, 1,1 GB
#   model.onnx             fp32, 2,3 GB   (arrastra model.onnx_data)
#
# Medido sobre 10 perfiles y 719 licitaciones: INT8 y fp32 dan la MISMA
# recomendación #1 en los 10, con una diferencia media de score de 0,01, y la
# INT8 es 1,23x más rápida. Por eso el default es la liviana.
#
# Ojo: RERANKER_TEMPERATURE y RERANKER_BIAS son la calibración (Platt scaling)
# de la variante INT8. Si cambias de variante, la distribución de los logits
# cambia y esos dos valores habría que re-medirlos con tests/matching_evaluation.
# RERANKER_ONNX_VARIANT=model_quantized.onnx
# RERANKER_TEMPERATURE=1.5
# RERANKER_BIAS=1.5
