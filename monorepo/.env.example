# Configuración del proyecto. Copia este archivo y completa solo lo de arriba:
#
#   cp .env.example .env
#
# Todo lo demás ya viene listo para desarrollo local con `supabase start`.


# ═════════════════════════════════════════════════════════════════
# 1. LO QUE TIENES QUE COMPLETAR  (2 valores)
# ═════════════════════════════════════════════════════════════════

# Ticket de la API de Mercado Público. Pídelo al equipo.
# La cuota (10.000 peticiones/día) es del ticket, no de tu máquina: si varios
# usan el mismo a la vez, se agota entre todos.
MERCADO_PUBLICO_API_KEY=

# Varios tickets, separados por coma. Como la cuota es del ticket, se suman: con
# tres son 30.000 peticiones al día. El cliente los gasta de a uno —cuando un 429
# sobrevive a los reintentos pasa al siguiente— en vez de repartir las peticiones
# entre todos, que gastaría los tres a la vez. Si se define, reemplaza a la lista
# completa; si no, se usa el ticket de arriba.
# MERCADO_PUBLICO_API_KEYS=ticket-1,ticket-2,ticket-3

# Clave de Gemini, para el análisis profundo. Pídela al equipo.
GEMINI_API_KEY=


# ═════════════════════════════════════════════════════════════════
# 2. LISTO PARA USAR  (no necesitas tocar nada de acá abajo)
# ═════════════════════════════════════════════════════════════════

GEMINI_MODEL=gemini-3.1-flash-lite

# --- Base de datos: Supabase local (`supabase start`) ---
# Gana sobre los POSTGRES_* de más abajo. Para apuntar a Supabase en la nube,
# cópiala de Project Settings > Database; se puede pegar tal cual venga
# (postgresql:// o postgres://), el código normaliza el driver.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Respaldo por si no defines DATABASE_URL. POSTGRES_PASSWORD tiene que existir
# aunque no se use.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proyectosya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Supabase Auth ---
# Las sesiones las emite Supabase; la API solo las verifica, y para eso descarga
# de acá las claves públicas de firma. En la nube: https://<ref>.supabase.co
# Fuera de desarrollo (IS_DEV=false) tiene que ser https, o la aplicación no
# arranca: por esa conexión viajan las claves con que se valida cada sesión.
SUPABASE_URL=http://127.0.0.1:54321

# Solo si el host que alcanza a Supabase no es el que firma los tokens. Dentro
# de Docker pasa: el contenedor llega por host.docker.internal, pero GoTrue
# emite iss: http://127.0.0.1:54321/auth/v1. Ya está resuelto en el compose.
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Las credenciales de Google NO van acá: las lee el CLI de Supabase del entorno
# de tu shell, no este archivo. Ver monorepo/backend/README.md, paso 5.

# --- Qdrant ---
# Dentro de docker compose, el servicio `api` sobrescribe el host a `qdrant`.
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Modo desarrollo ---
# Activa el log de SQL y afloja la exigencia de https en SUPABASE_URL.
# Debe ser false en producción.
IS_DEV=true

# --- Ingesta de Mercado Público ---
# Licitaciones por ciclo. 100 alcanza para trabajar en local; en producción, 2000.
MERCADOPUBLICO_FETCHING_LIMIT=100
# Pausa entre descargas de detalle, en segundos. Es un piso por cada descarga en
# curso, no una serialización: con concurrencia N hay N pausas en paralelo.
MERCADOPUBLICO_DETAIL_DELAY=0.5
# Detalles en vuelo a la vez. Más del 85% del tiempo por licitación es red, así
# que solapar las descargas es lo único que acorta una carga larga. Cinco es
# conservador: la API responde 429 cuando se la aprieta y el backoff del cliente
# lo absorbe, pero cada reintento igual sale de las 10.000 peticiones del día.
MERCADOPUBLICO_DETAIL_CONCURRENCY=5
# Heurística de respaldo para resolver comuna del comprador: busca el nombre
# de cualquier comuna en cualquier parte del nombre del organismo, no solo
# tras "Municipalidad de". Más cobertura, algo más de riesgo de falso
# positivo — apagada por defecto hasta decidir si vale la pena el riesgo.
ENABLE_COMUNA_GENERIC_HEURISTIC=false

# --- Importar datos de la empresa por RUT (HdU 16) ---
# Botón del wizard que, con el RUT ya validado, busca las actividades económicas
# de la empresa en el SII a través de una API de terceros y sugiere regiones,
# rubros y palabras clave. El usuario revisa y corrige antes de guardar: no se
# importa nada solo. De dónde salen estas fuentes: spikes/spike-1/1.1-onboarding.md.
#
# Se usa una sola fuente a la vez, y las dos devuelven el mismo borrador:
#
#   none            Apagado (por defecto). El botón queda deshabilitado y el
#                   wizard se llena a mano, igual que antes.
#
#   sre             POST a https://sre.cl/api/company_info, con el token en el
#                   cuerpo. Entrega razón social y códigos de actividad. NO
#                   entrega domicilio: no sugiere regiones y se lo avisa al
#                   usuario. Informa su cuota restante en cada respuesta, que
#                   queda registrada en los logs del backend.
#
#   web-empresario  GET a https://api-sii-chile.webempresario.com/v1/{rut}, con
#                   la credencial en la cabecera X-Api-Key. Además de lo
#                   anterior entrega región y si la empresa sigue vigente.
#
# Las dos son de pago y cobran por consulta; las credenciales las tiene el
# equipo. Si eliges una fuente y dejas la key vacía, la aplicación no arranca:
# es preferible a que falle recién cuando un usuario aprieta el botón.
COMPANY_LOOKUP_PROVIDER=none
COMPANY_LOOKUP_API_KEY=

# Solo si necesitas apuntar a otro host: un proxy, o un servidor de prueba que
# imite a la fuente. Vacía (lo normal) usa el host oficial de la fuente elegida.
# Ojo con Docker: dentro del contenedor, localhost es el contenedor mismo, así
# que un servidor que corra en tu máquina se alcanza por host.docker.internal.
# COMPANY_LOOKUP_BASE_URL=http://host.docker.internal:8787

# --- Alertas de nuevas licitaciones (HdU 08) ---
# En local no hay que tocar nada: los valores por defecto apuntan al servidor de
# correo de prueba que levanta `supabase start` (bandeja en
# http://localhost:54324). Para que acepte SMTP hay que descomentar
# `smtp_port = 54325` en supabase/config.toml y reiniciar Supabase.
#
# En producción se cambian solo estas variables, no el código. Con Brevo:
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587   SMTP_USE_TLS=true
#   SMTP_USER=<login SMTP>           SMTP_PASSWORD=<SMTP key>
# Con SendGrid, SMTP_USER es literalmente "apikey" y SMTP_PASSWORD la API key.
# El remitente debe estar verificado en el proveedor o rechazará todo envío.
SMTP_HOST=host.docker.internal
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@proyectosya.local
SMTP_USE_TLS=false

# Base de los enlaces que van dentro del correo. Tiene que ser la URL pública
# del frontend: es lo que el usuario abre desde su bandeja de entrada.
APP_BASE_URL=http://localhost:3000

# Detección en segundo plano. Ponlo en false para trabajar sin que corran los
# bucles de escaneo y envío.
RUN_NOTIFICATION_SCAN=true
# Cada cuánto se buscan licitaciones compatibles nuevas, en segundos. El
# escaneo ejecuta el reranker por cada empresa, así que bajarlo mucho compite
# con las peticiones de la API (un solo worker).
NOTIFICATION_SCAN_INTERVAL_SECONDS=300
# Hora de Chile a la que sale el resumen diario, para quien lo prefiera al
# aviso inmediato.
NOTIFICATION_DIGEST_HOUR=8


# --- Frontend autorizado (CORS) ---
# Separados por coma. Nunca "*": con cookies el navegador lo rechaza.
CORS_ORIGINS=http://localhost:3000


# --- Solo si estás en Windows con el repositorio en C:\ (no dentro de WSL2) ---
# Fuerza a uvicorn --reload a sondear los archivos: los eventos de inotify no
# cruzan esa frontera y el hot reload deja de funcionar.
# WATCHFILES_FORCE_POLLING=1

# --- Solo si necesitas acotar la ingesta a una región ---
# OJO: para NO filtrar, deja esta línea comentada. `TARGET_REGION=null` no
# funciona: se lee como el texto "null", que es un valor válido, y no entraría
# ninguna licitación.
# TARGET_REGION=Región Metropolitana de Santiago

# El resto de la configuración (variante del reranker y su calibración, pooler de
# Postgres, atributos de la cookie) tiene valores por defecto correctos para
# desarrollo. Están documentados en backend/app/config.py cuando hagan falta.
